{
  "rabbit_version": "3.11.0",
  "vhosts": [{ "name": "/" }],
  "queues": [
    { "name": "search.apartment.change", "vhost": "/", "durable": true },
    { "name": "booking.apartment.change", "vhost": "/", "durable": true }
  ],
  "exchanges": [
    {
      "name": "apartment.change",
      "vhost": "/",
      "type": "fanout",
      "durable": true
    }
  ],
  "bindings": [
    {
      "source": "apartment.change",
      "vhost": "/",
      "destination": "search.apartment.change",
      "destination_type": "queue",
      "routing_key": ""
    },
    {
      "source": "apartment.change",
      "vhost": "/",
      "destination": "booking.apartment.change",
      "destination_type": "queue",
      "routing_key": ""
    }
  ],
  "users": [
    {
      "name": "bstayuser",
      "password": "bstaypass",
      "tags": "administrator",
      "permissions": [
        { "vhost": "/", "configure": ".*", "write": ".*", "read": ".*" }
      ]
    },
    {
      "name": "guest",
      "password": "guest",
      "tags": "administrator",
      "permissions": [
        { "vhost": "/", "configure": ".*", "write": ".*", "read": ".*" }
      ]
    }
  ]
}
